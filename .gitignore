# ==============================================================================
# VOYAGELEDGER ERP — GITIGNORE SECURITY & ENVIRONMENT ISOLATION
# ==============================================================================

# 1. Environment and Secrets (Ignore all active .env files, allow templates)
.env
.env.*
.env.local
.env.staging
.env.production
.env.test
!.env.example
!.env.*.example
!.env.local.example
!.env.staging.example

# 2. Cryptographic Keys & Certificates
*.pem
*.key
*.pkcs12
*.pfx
*.p12
*.crt
*.cer
*.pub

# 3. Google Cloud Platform & Service Account Secrets
*service-account*.json
*credentials*.json
*gcp-key*.json
*client_secret*.json
*google-services*.json
*.sa.json

# 4. Database Files, SQLite & Dumps
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal
*.sql.gz
*.dump

# 5. Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 6. Next.js Build Outputs & Cache
/.next/
/out/
/build
/dist
/.vercel
*.tsbuildinfo
next-env.d.ts

# 7. Testing & Coverage
/coverage

# 8. Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# 9. OS & IDE artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
