# ==============================================================================
# VOYAGELEDGER ERP - STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.staging or set these variables in your staging environment.
# DO NOT COMMIT ACTUAL PASSWORDS, SECRET KEYS, OR CREDENTIALS TO SOURCE CONTROL.
# ==============================================================================

# Database Connection (Staging PostgreSQL / Cloud SQL Proxy)
# Format: postgresql://[DB_USER]:[DB_PASSWORD]@[DB_HOST]:[DB_PORT]/[DB_NAME]?schema=public&sslmode=prefer
DATABASE_URL="postgresql://staging_user:CHANGE_ME_STAGING_PASSWORD@127.0.0.1:5432/travel_erp_staging?schema=public"

# Google Cloud Platform (Staging Project)
GCP_PROJECT_ID="travel-accounting-2026-staging"
GCS_BUCKET_NAME="travel-accounting-staging-docs-2026"
GOOGLE_APPLICATION_CREDENTIALS="/path/to/staging-service-account-key.json"

# Authentication & Session Security (Generate strong random 64-character secrets)
SESSION_SECRET="CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_SECRET_FOR_STAGING_SESSION"
NEXTAUTH_URL="https://staging.voyageledger.internal"
NEXTAUTH_SECRET="CHANGE_ME_GENERATE_A_RANDOM_64_CHAR_HEX_SECRET_FOR_STAGING_AUTH"

# Application Environment
APP_ENV="staging"
NODE_ENV="production"
PORT=3000

# Afghanistan Localization Defaults
NEXT_PUBLIC_APP_NAME="VoyageLedger ERP (Staging)"
NEXT_PUBLIC_COMPANY_NAME="Ariana Silk Road Travel & Tours (Staging Test)"
NEXT_PUBLIC_DEFAULT_CURRENCY="AFN"
NEXT_PUBLIC_DEFAULT_COUNTRY="Afghanistan"
