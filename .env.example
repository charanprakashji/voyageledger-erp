# Database Configuration (PostgreSQL / Google Cloud SQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/travel_erp?schema=public"

# Google Cloud Platform
GCP_PROJECT_ID="travel-accounting-2026"
GCS_BUCKET_NAME="travel-accounting-2026-docs"
# Path to GCP Service Account JSON key (for Cloud Storage signed URLs)
GOOGLE_APPLICATION_CREDENTIALS=""

# Authentication & Security
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="super-secret-random-key-change-in-production"

# Application Settings (Afghanistan Localization)
NEXT_PUBLIC_APP_NAME="VoyageLedger ERP"
NEXT_PUBLIC_COMPANY_NAME="Ariana Horizon Travel & Tourism"
NEXT_PUBLIC_DEFAULT_CURRENCY="AFN"
NEXT_PUBLIC_DEFAULT_COUNTRY="Afghanistan"
