{
  "name": "antigravity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "test": "npx tsx tests/test_staging_safety.ts && npx tsx tests/test_auth_security.ts && npx tsx tests/test_pre_deployment_audit.ts && npx tsx test_phase1.ts && npx tsx test_phase2.ts && npx tsx test_phase3.ts && npx tsx test_phase4.ts && npx tsx test_phase5.ts",
    "test:auth": "npx tsx tests/test_auth_security.ts",
    "test:audit": "npx tsx tests/test_pre_deployment_audit.ts",
    "test:safety": "npx tsx tests/test_staging_safety.ts",
    "postinstall": "prisma generate",
    "db:setup:local": "npx tsx scripts/setup_local_db.ts && npx prisma db push && npx tsx prisma/seed_local.ts",
    "db:seed:local": "npx tsx prisma/seed_local.ts",
    "db:seed:staging": "npx tsx prisma/seed_staging.ts",
    "db:reset:staging": "npx tsx scripts/staging_reset.ts && npx tsx prisma/seed_staging.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed_local.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.15.2",
    "@neon/config": "^1.4.2",
    "@neon/env": "^1.3.2",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^5.22.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
